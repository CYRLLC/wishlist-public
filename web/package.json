  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-react": "latest",
    "firebase": "latest",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "^5.0.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
