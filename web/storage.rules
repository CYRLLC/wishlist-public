rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member(cid) {
      return request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/couples/$(cid)).data.members;
    }
    match /couples/{cid}/{uid}/{folder}/{filename} {
      allow read: if member(cid) && folder in ['wish-images', 'expense-images'];
      allow create: if member(cid) && request.auth.uid == uid
        && folder in ['wish-images', 'expense-images']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if member(cid) && request.auth.uid == uid;
    }
    // Legacy files are served by the authenticated readPrivateImage function.
    match /{file=**} { allow read, write: if false; }
  }
}
